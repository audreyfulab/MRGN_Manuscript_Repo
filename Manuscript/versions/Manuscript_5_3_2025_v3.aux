\newlabel{fig:main_all_edge}{{3}{37}{\textbf {Precision and recall curves of edge-based prediction performance for MRGNtrio, and MRPC with confounder selection}. (A) the number of simulated hidden confounders (B) Minor allele frequency of the genetic variant, (C) The signal strength of the $T_1 - T_2$ edge, and (D) The standard deviation of the regression residuals}{suppfigure.caption.12}{}}
\@writefile{lsf}{\contentsline {suppfigure}{\numberline {4}{\ignorespaces \textbf  {Comparison of computation times between our implementation of the CSFDR method for confounder selection and that of the GMAC method \cite  {yang2017identifying}}. Computation times are shown across different numbers of input trios and sizes of the candidate confounder pool.}}{38}{suppfigure.caption.13}\protected@file@percent }
\newlabel{fig:SF1_comp_times_for_conf_selection_updated}{{4}{38}{\textbf {Comparison of computation times between our implementation of the CSFDR method for confounder selection and that of the GMAC method \cite {yang2017identifying}}. Computation times are shown across different numbers of input trios and sizes of the candidate confounder pool}{suppfigure.caption.13}{}}
\@writefile{lsf}{\contentsline {suppfigure}{\numberline {5}{\ignorespaces \textbf  {Impact of the causal permutation test on inference and categorization of model changes for GTEx whole blood trios.} (A) A $p$-value plot ($\log _{10}$ scale) comparing the observed $p$-value from the Wald test for $\beta _{12}: T_1 \perp \!\!\! \perp T_2 \mid (V,U)$ with the $p$-value from the permutation test. (B) A $p$-value plot for the conditional test $\beta _{22}: T_2 \perp \!\!\! \perp T_1 \mid (V,U)$ showing the permutation-based $p$-values (y-axis) versus the standard Wald test. Red dotted lines indicate the significance threshold on the log scale. (C) Categorization and counts of inferred model changes resulting from using the permutation test instead of the standard Wald test. (D) Minor allele frequencies of trios whose inferred models changed compared with those that did not change after applying the permutation test for $\beta _{12}$ and $\beta _{22}$.}}{39}{suppfigure.caption.14}\protected@file@percent }
\newlabel{fig:SF3_GTEx_Permutation_and_Model_Changes}{{5}{39}{\textbf {Impact of the causal permutation test on inference and categorization of model changes for GTEx whole blood trios.} (A) A $p$-value plot ($\log _{10}$ scale) comparing the observed $p$-value from the Wald test for $\beta _{12}: T_1 \indep T_2 \mid (V,U)$ with the $p$-value from the permutation test. (B) A $p$-value plot for the conditional test $\beta _{22}: T_2 \indep T_1 \mid (V,U)$ showing the permutation-based $p$-values (y-axis) versus the standard Wald test. Red dotted lines indicate the significance threshold on the log scale. (C) Categorization and counts of inferred model changes resulting from using the permutation test instead of the standard Wald test. (D) Minor allele frequencies of trios whose inferred models changed compared with those that did not change after applying the permutation test for $\beta _{12}$ and $\beta _{22}$}{suppfigure.caption.14}{}}
\@writefile{lsf}{\contentsline {suppfigure}{\numberline {6}{\ignorespaces Impact of the permutation test on causal inference for simulated trios}}{40}{suppfigure.caption.15}\protected@file@percent }
\newlabel{fig:SF5_Simulation_Permutation_and_Model_Changes}{{6}{40}{Impact of the permutation test on causal inference for simulated trios}{suppfigure.caption.15}{}}
\@writefile{lsf}{\contentsline {suppfigure}{\numberline {7}{\ignorespaces \textbf  {Skewness and kurtosis for cis and trans genes by allele frequency}. Stacked histograms showing the sampling distributions of sample skewness and excess kurtosis for cis and trans genes in GTEx trios. Results are segregated by the minor allele frequency of the genetic variant, highlighting differences between common and rare alleles.}}{41}{suppfigure.caption.16}\protected@file@percent }
\newlabel{fig:SF8_Trio_Skew_Stat_Distribtuions}{{7}{41}{\textbf {Skewness and kurtosis for cis and trans genes by allele frequency}. Stacked histograms showing the sampling distributions of sample skewness and excess kurtosis for cis and trans genes in GTEx trios. Results are segregated by the minor allele frequency of the genetic variant, highlighting differences between common and rare alleles}{suppfigure.caption.16}{}}
\@writefile{lsf}{\contentsline {suppfigure}{\numberline {8}{\ignorespaces \textbf  {Example of a trio with a rare variant acting as an outlier.} In this trio, a single individual homozygous for the minor allele drives non-normality in trans-gene expression relative to the population. This individual (yellow point) also shows elevated expression of the cis gene. Initially, MRGNTrio inferred model M4 for this trio, while GMAC inferred no mediation. Applying the permutation test caused MRGNTrio to recover the same inference (the null model) as GMAC.}}{42}{suppfigure.caption.17}\protected@file@percent }
\newlabel{fig:trio_number_730}{{8}{42}{\textbf {Example of a trio with a rare variant acting as an outlier.} In this trio, a single individual homozygous for the minor allele drives non-normality in trans-gene expression relative to the population. This individual (yellow point) also shows elevated expression of the cis gene. Initially, MRGNTrio inferred model M4 for this trio, while GMAC inferred no mediation. Applying the permutation test caused MRGNTrio to recover the same inference (the null model) as GMAC}{suppfigure.caption.17}{}}
