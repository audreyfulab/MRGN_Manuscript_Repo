\newlabel{fig:main_GTEx}{{4}{31}{Performance of MRGNtrio on GTEx human whole blood trios}{figure.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Conditional and marginal dependence tests used by MRGNTrio.} This table summarizes the tests applied to determine which model is supported by the data. The first three models each have two possible configurations. Coefficients $\beta _{11}$ and $\beta _{12}$ come from the regression in \autoref {eq:reg1}, and $\beta _{21}$ and $\beta _{22}$ from the regression in \autoref {eq:reg2}; these coefficients are used to assess conditional independence. Marginal independence is tested using the correlations $r_{V, T_1}$ and $r_{V, T_2}$.}}{32}{table.caption.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Recall and precision for MRGNtrio and MRPC-ADDIS on simulated trios with confounding variables.} The highest precision and recall for each model or edge is highlighted in each row. The first column indicates the performance of MRGNtrio when the true set of confounders is used in inference for comparison. We also consider two selection methods for inferring the confounders for each trio: (i) FDR correction with the qvalue method to control the FDR at $5\%$ (CSFDR) and (ii) no FDR correction and significance taken at the $\alpha < 0.01$ level (CSnoFDR). Additional columns represent performance for MRPC-ADDIS using the CSDFR method for selecting confounders. Rows 1-5 indicate class-based performances for each of the 5 causal models, row 6 gives performance for predicting the $T_1-T_2$ edge ($\ast $ indicates similar values were observed for GMAC), and the last row gives the performance across all edges in the network using the weighting scheme described in the Section ``Performance metrics".}}{33}{table.caption.7}\protected@file@percent }
\newlabel{tab:results}{{2}{33}{\textbf {Recall and precision for MRGNtrio and MRPC-ADDIS on simulated trios with confounding variables.} The highest precision and recall for each model or edge is highlighted in each row. The first column indicates the performance of MRGNtrio when the true set of confounders is used in inference for comparison. We also consider two selection methods for inferring the confounders for each trio: (i) FDR correction with the qvalue method to control the FDR at $5\%$ (CSFDR) and (ii) no FDR correction and significance taken at the $\alpha < 0.01$ level (CSnoFDR). Additional columns represent performance for MRPC-ADDIS using the CSDFR method for selecting confounders. Rows 1-5 indicate class-based performances for each of the 5 causal models, row 6 gives performance for predicting the $T_1-T_2$ edge ($\ast $ indicates similar values were observed for GMAC), and the last row gives the performance across all edges in the network using the weighting scheme described in the Section ``Performance metrics"}{table.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Inference times for MRGNtrio, MRPC-ADDIS, and GMAC} on simulated trios. MRGNtrio shows a substantially faster median inference time per trio compared to both MRPC-ADDIS and GMAC, demonstrating its computational efficiency in the presence of confounding.}}{33}{table.caption.8}\protected@file@percent }
\newlabel{tab:time_comp}{{3}{33}{\textbf {Inference times for MRGNtrio, MRPC-ADDIS, and GMAC} on simulated trios. MRGNtrio shows a substantially faster median inference time per trio compared to both MRPC-ADDIS and GMAC, demonstrating its computational efficiency in the presence of confounding}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {A summary of type II error rates for MRGNtrio under model misspecification}. This table reports the type I and type II error rates under four simulation scenarios investigating model misspecification. Small True Model Simulation (STMS): The trans gene is simulated using only the most significant confounders, while the inference model includes additional, less significant confounders, representing model overspecification. Large True Model Simulation (LTMS): The trans gene is simulated with a larger set of confounders, but the inference model omits weaker confounders, representing model underspecification. Correct Model Simulation (CMS) - The same model is used for both simulation and inference, assessing the stability of the permutation test when the model is correctly specified. Small Inference Model Simulation (SIMS) - The trans gene is generated using a full model, but inference is performed with only a small subset of top confounders.}}{34}{table.caption.9}\protected@file@percent }
\newlabel{tab:S10_Model_miss_Type_II_error_rates}{{4}{34}{\textbf {A summary of type II error rates for MRGNtrio under model misspecification}. This table reports the type I and type II error rates under four simulation scenarios investigating model misspecification. Small True Model Simulation (STMS): The trans gene is simulated using only the most significant confounders, while the inference model includes additional, less significant confounders, representing model overspecification. Large True Model Simulation (LTMS): The trans gene is simulated with a larger set of confounders, but the inference model omits weaker confounders, representing model underspecification. Correct Model Simulation (CMS) - The same model is used for both simulation and inference, assessing the stability of the permutation test when the model is correctly specified. Small Inference Model Simulation (SIMS) - The trans gene is generated using a full model, but inference is performed with only a small subset of top confounders}{table.caption.9}{}}
\@writefile{lsf}{\contentsline {suppfigure}{\numberline {1}{\ignorespaces \textbf  {The three types of confounding variables to consider in causal inference of genetic trios}. A confounder (left) is a gene which regulates both molecular phenotypes, an intermediate variable (center) is a gene which mediates part of the effect of the genetic variant and its target, and a common child (right) is a shared target of both molecular phenotypes.}}{35}{suppfigure.caption.10}\protected@file@percent }
\newlabel{fig:confounding}{{1}{35}{\textbf {The three types of confounding variables to consider in causal inference of genetic trios}. A confounder (left) is a gene which regulates both molecular phenotypes, an intermediate variable (center) is a gene which mediates part of the effect of the genetic variant and its target, and a common child (right) is a shared target of both molecular phenotypes}{suppfigure.caption.10}{}}
\@writefile{lsf}{\contentsline {suppfigure}{\numberline {2}{\ignorespaces \textbf  {Precision-recall curves for predicting the $T_1 - T_2$ edge across multiple simulation parameters}. (A) the number of simulated hidden confounders (B) Minor allele frequency of the genetic variant, (C) The signal strength of the $T_1 - T_2$ edge, and (D) The standard deviation of the regression residuals.}}{36}{suppfigure.caption.11}\protected@file@percent }
\newlabel{fig:main_t1_t2_inf}{{2}{36}{\textbf {Precision-recall curves for predicting the $T_1 - T_2$ edge across multiple simulation parameters}. (A) the number of simulated hidden confounders (B) Minor allele frequency of the genetic variant, (C) The signal strength of the $T_1 - T_2$ edge, and (D) The standard deviation of the regression residuals}{suppfigure.caption.11}{}}
